# gcloud commands typed in this repo use uke's own config, not the machine-wide ~/.config/gcloud.
# uke itself reads ~/.config/gcloud-uke regardless (see README, "Google credentials").
export CLOUDSDK_CONFIG="$HOME/.config/gcloud-uke"
# Local settings such as UKE_GCP_PROJECT go in .env (gitignored).
dotenv_if_exists
